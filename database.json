{"user_state":{},"classrooms":{"TOS-BIYC-XKG4-OFTM":{"active_assignment":{"level":"B1","roomKey":"TOS-BIYC-XKG4-OFTM","assigned_at":1790104116,"classroomData":{"rules":[{"desc":"Harakat odatda sodir bo'lganda: am / is / are + V3 (Past Participle) ishlatiladi.","title":"📌 1-Qoida: Present Simple Passive Formulasi","examples":["English is spoken all over the world.","Millions of messages are sent every minute."]},{"title":"⚡ 2-Qoida: 'By' agentini to'g'ri ishlatish","desc":"Bajaruvchini ta'kidlash kerak bo'lsa 'by' predlogi qo'yiladi, noma'lum bo'lsa tushirib qoldiriladi.","examples":["The Mona Lisa was painted by Leonardo da Vinci.","The thief was arrested immediately."]}],"teacherName":"MWF Beginner 14:00","teacherChatId":8845531824,"hwMcqs":[{"q":"English ______ in many schools across the globe.","expl":"'English' birlik ot: is + V3 'spoken'.","opts":["is spoken","is speak","are spoken","speaks"],"ans":"is spoken"},{"q":"Millions of emails ______ every single day.","expl":"'Emails' ko'plik ot: are + V3 'sent' (send -> sent).","ans":"are sent","opts":["are sent","is sent","are send","send"]},{"q":"These smartphones ______ in high-tech factories.","expl":"Passive Voice: are + V3 'produced'.","ans":"are produced","opts":["are produced","is produced","produce","are produce"]},{"ans":"was painted","opts":["was painted","is paint","painted","was paint"],"expl":"O'tmishdagi Passive: was + V3 'painted'.","q":"The Mona Lisa ______ by Leonardo da Vinci."},{"q":"Breakfast ______ from 7:00 to 10:00 AM every morning.","expl":"Breakfast birlik: is served.","opts":["is served","is serve","serves","are served"],"ans":"is served"},{"ans":"were sold","opts":["were sold","was sold","sold","are sell"],"expl":"'Tickets' ko'plik ot + o'tgan zamon: were + V3 'sold'.","q":"All the concert tickets ______ in less than two hours."},{"ans":"is never given","opts":["is never given","never is given","is given never","gives never"],"expl":"'never' to be va V3 orasida turadi: is never given.","q":"The secret code ______ to unauthorized people."},{"ans":"was built","opts":["was built","is built","built","was build"],"expl":"build -> built -> built. Aniq o'tgan yil uchun 'was built'.","q":"This historic bridge ______ in 1950."},{"opts":["To'g'ri variant","Noto'g'ri zamon","Chalkash predlog","Noto'g'ri fe'l"],"ans":"To'g'ri variant","expl":"'Passive Voice' qoidasiga to'liq mos keladi.","q":"Vazifa 9: 'Passive Voice' mavzusiga oid qaysi variant grammatik jihatdan to'g'ri?"},{"q":"Vazifa 10: 'Passive Voice' mavzusiga oid qaysi variant grammatik jihatdan to'g'ri?","ans":"To'g'ri variant","opts":["To'g'ri variant","Noto'g'ri zamon","Chalkash predlog","Noto'g'ri fe'l"],"expl":"'Passive Voice' qoidasiga to'liq mos keladi."}],"focus":"am/is/are + V3, to be moslashuvi, by agent qoidasi, o'zbekcha -iladi tuzoqlari","flashcards":[{"pos":"verb","uz":"ishlab chiqarmoq","word":"manufacture","uzEx":"Asakada avtomobillar ishlab chiqariladi.","enEx":"Cars are manufactured in Asaka."},{"pos":"verb","uz":"yetkazib bermoq","word":"deliver","uzEx":"Posilkalar har kuni yetkazib beriladi.","enEx":"Parcels are delivered daily."},{"uzEx":"Har yili yangi davolar kashf etiladi.","word":"discover","enEx":"New cures are discovered every year.","pos":"verb","uz":"kashf etmoq"},{"pos":"verb","uz":"ixtiro qilmoq","word":"invent","uzEx":"Radio ancha avval ixtiro qilingan.","enEx":"The radio was invented long ago."},{"pos":"verb","uz":"saylamoq","enEx":"The leader is elected by the citizens.","uzEx":"Rahbar fuqarolar tomonidan saylanadi.","word":"elect"},{"uzEx":"Yangi maqolalar internetda nashr etiladi.","word":"publish","enEx":"New articles are published online.","pos":"verb","uz":"chop etmoq, nashr qilmoq"},{"pos":"adjective","uz":"o'ta muhim, zarur","word":"essential","uzEx":"Grammatikani o'rganish o'ta muhimdir.","enEx":"It is essential to learn grammar."},{"uz":"anglamoq, to'liq tushunmoq","pos":"verb","word":"comprehend","uzEx":"O'quvchilar darsni to'liq tushunishadi.","enEx":"Students comprehend the lesson."},{"uz":"mustahkamlamoq","pos":"verb","uzEx":"Mashq xotirani mustahkamlaydi.","word":"reinforce","enEx":"Practice reinforces your memory."},{"uzEx":"Faol va majhul nisbatni farqlang.","word":"distinguish","enEx":"Distinguish between active and passive.","uz":"farqlamoq, ajratmoq","pos":"verb"}],"translations":[{"uz":"1. O'zbekistonda har yili minglab avtomobillar ishlab chiqariladi.","hint":"Cars are manufactured / produced every year"},{"hint":"English is spoken worldwide as an international language","uz":"2. Ingliz tili xalqaro muloqot tili sifatida butun dunyoda gapiriladi."},{"hint":"The letter was delivered yesterday morning","uz":"3. Bu xat kecha ertalab pochta orqali yetkazib berildi."},{"uz":"4. Yangi kutubxona shahar markazida qurilmoqda.","hint":"is being built / is built"},{"uz":"5. Barcha test natijalari kompyuter orqali tekshiriladi.","hint":"All test results are checked by computer"},{"uz":"6. Bu asar mashhur adib tomonidan yozilgan.","hint":"This work was written by a famous author"}],"roomKey":"TOS-BIYC-XKG4-OFTM","quiz":[{"q":"English ______ in many schools across the globe.","expl":"'English' birlik ot: is + V3 'spoken'.","ans":"is spoken","opts":["is spoken","is speak","are spoken","speaks"]},{"q":"Millions of emails ______ every single day.","expl":"'Emails' ko'plik ot: are + V3 'sent' (send -> sent).","ans":"are sent","opts":["are sent","is sent","are send","send"]},{"expl":"Passive Voice: are + V3 'produced'.","opts":["are produced","is produced","produce","are produce"],"ans":"are produced","q":"These smartphones ______ in high-tech factories."},{"q":"The Mona Lisa ______ by Leonardo da Vinci.","ans":"was painted","opts":["was painted","is paint","painted","was paint"],"expl":"O'tmishdagi Passive: was + V3 'painted'."},{"q":"Breakfast ______ from 7:00 to 10:00 AM every morning.","expl":"Breakfast birlik: is served.","ans":"is served","opts":["is served","is serve","serves","are served"]},{"ans":"were sold","opts":["were sold","was sold","sold","are sell"],"expl":"'Tickets' ko'plik ot + o'tgan zamon: were + V3 'sold'.","q":"All the concert tickets ______ in less than two hours."},{"ans":"is never given","opts":["is never given","never is given","is given never","gives never"],"expl":"'never' to be va V3 orasida turadi: is never given.","q":"The secret code ______ to unauthorized people."},{"opts":["was built","is built","built","was build"],"ans":"was built","expl":"build -> built -> built. Aniq o'tgan yil uchun 'was built'.","q":"This historic bridge ______ in 1950."}],"slides":[{"tag":"1. HOOK & ASOSIY TUSHUNCHA","body":"\n              <div style=\"margin-bottom: 1rem;\">\n                Passive Voice (Majhul nisbat) — ish-harakatni <b>KIM</b> bajarganidan ko'ra, harakatning <b>O'ZI va NATIJASI</b> muhim bo'lganda ishlatiladi.\n              </div>\n              <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;\">\n                <div style=\"background: rgba(99, 102, 241, 0.1); border-left: 3px solid #6366f1; padding: 0.85rem; border-radius: 6px;\">\n                  <div style=\"font-weight: 700; color: #a5b4fc; font-size: 0.85rem;\">🔵 Active Voice (Aniq)</div>\n                  <div style=\"font-size: 0.9rem; color: #f1f5f9; margin-top: 4px;\"><i>'People produce cars in Asaka.'</i></div>\n                  <div style=\"font-size: 0.75rem; color: #94a3b8; margin-top: 2px;\">(Odamlar Asakada mashina ishlab chiqarishadi)</div>\n                </div>\n                <div style=\"background: rgba(16, 185, 129, 0.1); border-left: 3px solid #10b981; padding: 0.85rem; border-radius: 6px;\">\n                  <div style=\"font-weight: 700; color: #6ee7b7; font-size: 0.85rem;\">🟢 Passive Voice (Majhul)</div>\n                  <div style=\"font-size: 0.9rem; color: #f1f5f9; margin-top: 4px;\"><i>'Cars are produced in Asaka.'</i></div>\n                  <div style=\"font-size: 0.75rem; color: #94a3b8; margin-top: 2px;\">(Mashinalar Asakada ishlab chiqariladi!)</div>\n                </div>\n              </div>\n            ","title":"Active vs Passive: Diqqat Markazini O'zgartirish"},{"body":"\n              <div style=\"background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 8px; padding: 1rem; margin-bottom: 1rem;\">\n                <div style=\"font-weight: 800; color: #bae6fd; font-size: 1.1rem; text-align: center;\">\n                  Object + <span style=\"color: #38bdf8;\">AM / IS / ARE</span> + <span style=\"color: #34d399;\">V3 (Fe'lning 3-shakli)</span>\n                </div>\n              </div>\n              <div style=\"display: flex; justify-content: space-between; font-size: 0.9rem; line-height: 1.7; flex-wrap: wrap; gap: 0.75rem;\">\n                <div style=\"flex: 1; min-width: 140px;\">\n                  <b>Birlik otlar (He/She/It):</b><br>\n                  <code style=\"color: #38bdf8; background: rgba(0,0,0,0.3); padding: 2px 6px; border-radius: 4px;\">IS + V3</code><br>\n                  <i>'English is spoken here.'</i>\n                </div>\n                <div style=\"flex: 1; min-width: 140px;\">\n                  <b>Ko'plik otlar (We/They):</b><br>\n                  <code style=\"color: #a78bfa; background: rgba(0,0,0,0.3); padding: 2px 6px; border-radius: 4px;\">ARE + V3</code><br>\n                  <i>'Apples are exported.'</i>\n                </div>\n              </div>\n            ","title":"Subject + AM / IS / ARE + V3 (Past Participle)","tag":"2. FORMULA VA GAP TUZILISHI"},{"tag":"3. O'ZBEKCHA TUZOQ: '-ILADI / -ILADI'","title":"O'zbek Tilidagi '-iladi' Qo'shimchasi","body":"\n              <div style=\"margin-bottom: 0.75rem;\">\n                O'zbek tilidagi <i>'qilinadi, aytiladi, sotiladi, quriladi'</i> so'zlari ingliz tilida Passive Voice orqali beriladi.<br><br>\n                ⚠️ <b>ENG KATTA TUZOQ:</b> Hech qachon V1 yoki V2 ishlatmang!<br>\n                ❌ <i>'English is speak worldwide.'</i> (Qo'pol xato!)<br>\n                ✅ <i>'English is <b>spoken</b> worldwide.'</i> (speak ➔ spoke ➔ <b>spoken</b>)\n              </div>\n            "},{"body":"\n              <div style=\"font-size: 0.95rem; line-height: 1.8;\">\n                • <b>Bajaruvchi muhim bo'lsa:</b> <code>by + shaxs</code> qo'yiladi:<br>\n                <i>'The Mona Lisa was painted <b>by Leonardo da Vinci</b>.'</i><br><br>\n                • <b>Bajaruvchi umumiy yoki noma'lum bo'lsa:</b> tushirib qoldiriladi:<br>\n                <i>'Toyota cars are manufactured in Japan.'</i> (by people shart emas!)\n              </div>\n            ","title":"Harakat Bajaruvchisi Muhim Bo'lsa","tag":"4. 'BY + AGENT' QACHON ISHLATILADI?"},{"tag":"5. ENG KO'P QILINADIGAN 3 TA XATO","title":"O'quvchilar Yo'l Qo'yadigan Tuzoqlar","body":"\n              <div style=\"font-size: 0.9rem; line-height: 1.7;\">\n                ❌ <b>1-Xato (To be ni unutish):</b> <i>'This book written in 2020.'</i><br>\n                ✅ <b>To'g'risi:</b> <i>'This book <b>was written</b> in 2020.'</i><br><br>\n                ❌ <b>2-Xato (Ko'plikda 'is' ishlatish):</b> <i>'Cars is produced daily.'</i><br>\n                ✅ <b>To'g'risi:</b> <i>'Cars <b>are produced</b> daily.'</i><br><br>\n                ❌ <b>3-Xato (V2 ishlatish):</b> <i>'The email was wrote yesterday.'</i><br>\n                ✅ <b>To'g'risi:</b> <i>'The email was <b>written</b> yesterday.'</i>\n              </div>\n            "},{"title":"Sinfda Jonli Mashq (Google Meet / Zoom)","body":"\n              <div style=\"background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 1.25rem;\">\n                <div style=\"font-weight: 800; color: #a7f3d0; margin-bottom: 0.5rem;\">🗣️ Juftlikda / Ustoz bilan Mashq:</div>\n                <div style=\"font-size: 0.95rem; color: #cbd5e1;\">\n                  1. <i>'What famous products are made in Uzbekistan?'</i> (e.g. Silk, cars, fresh fruits)<br>\n                  2. <i>'How is traditional Uzbek plov cooked?'</i> (e.g. Meat is fried first...)<br>\n                  3. <i>'Where is your favorite song listened to?'</i>\n                </div>\n              </div>\n            ","tag":"6. JONLI NUTQ & SPEAKING CHALLENGE"},{"tag":"7. AMALIY SINF MASHQI (Classroom Drill)","body":"\n                <div style=\"background: rgba(99, 102, 241, 0.12); border-left: 4px solid #6366f1; padding: 1.25rem; border-radius: 6px; text-align: left;\">\n                  <div style=\"font-weight: 800; color: #a5b4fc; font-size: 1.05rem; margin-bottom: 0.5rem;\">⚡ Tezkor Sinf Vazifasi:</div>\n                  <div style=\"font-size: 0.95rem; color: #e2e8f0; line-height: 1.7;\">\n                    1. <b>Passive Voice</b> qoidasiga mos 3 ta ijobiy va 2 ta inkor gap ayting.<br>\n                    2. Hamkor sherigingizning gaplaridagi nozik xatolarni toping.<br>\n                    3. Haqiqiy hayotiy vaziyatda ushbu qoidani qo'llab ko'ring.\n                  </div>\n                </div>\n              ","title":"Passive Voice — Jonli Mashq & Amaliy Tahlil"},{"body":"\n                <div style=\"background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; padding: 1.25rem; text-align: left;\">\n                  <div style=\"font-weight: 800; color: #6ee7b7; font-size: 1.05rem; margin-bottom: 0.5rem;\">🎯 Bugun Nimalarni O'rgandik?</div>\n                  <div style=\"font-size: 0.95rem; color: #f1f5f9; line-height: 1.7;\">\n                    • <b>Passive Voice</b> ning mohiyati va formulasi.<br>\n                    • Eng ko'p uchraydigan tuzoqlar va ulardan qochish choralari.<br>\n                    • Mustaqil uyga vazifani bajarish uchun zarur kalit qoidalar.\n                  </div>\n                </div>\n              ","title":"Passive Voice — Asosiy Xulosalar & Mustahkamlash","tag":"8. DARS XULOSASI & KEYINGI QADAMLAR"}],"speakingPrompt":"Ovozli vazifa: 1 daqiqalik audio xabarda '